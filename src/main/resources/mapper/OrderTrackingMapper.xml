<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.campusmall.mall.mapper.OrderTrackingMapper">

    <resultMap id="OrderTrackingMap" type="com.campusmall.mall.entity.OrderTracking">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="status" column="status"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="getById" resultMap="OrderTrackingMap">
        SELECT * FROM order_tracking WHERE id = #{id}
    </select>

    <select id="getAll" resultMap="OrderTrackingMap">
        SELECT * FROM order_tracking
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_tracking(order_id, status, description, created_at)
        VALUES(#{orderId}, #{status}, #{description}, #{createdAt})
    </insert>

    <update id="update">
        UPDATE order_tracking
        SET order_id=#{orderId}, status=#{status}, description=#{description}, created_at=#{createdAt}
        WHERE id=#{id}
    </update>

    <delete id="delete">
        DELETE FROM order_tracking WHERE id=#{id}
    </delete>

</mapper>
