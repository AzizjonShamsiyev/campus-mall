<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.campusmall.mall.mapper.CategoryMapper">

    <resultMap id="CategoryMap" type="com.campusmall.mall.entity.Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="getById" resultMap="CategoryMap">
        SELECT * FROM categories WHERE id = #{id}
    </select>

    <select id="getAll" resultMap="CategoryMap">
        SELECT * FROM categories
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories(name, description, status)
        VALUES(#{name}, #{description}, #{status})
    </insert>

    <update id="update">
        UPDATE categories
        SET name=#{name}, description=#{description}, status=#{status}
        WHERE id=#{id}
    </update>

    <delete id="delete">
        DELETE FROM categories WHERE id=#{id}
    </delete>

</mapper>
